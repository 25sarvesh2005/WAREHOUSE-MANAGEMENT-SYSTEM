APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
JWT_SECRET=replace-with-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
AI_ENABLED=true
AI_PROVIDER=google_genai
AI_MODEL=gemini-2.0-flash-lite
AI_LOG_PROMPT_EXCERPTS=false
AI_PROMPT_EXCERPT_CHARS=500
AI_RESPONSE_EXCERPT_CHARS=2000
GOOGLE_GENAI_API_KEY=
# Voice AI (Sarvam)
VOICE_STT_PROVIDER=sarvam
VOICE_TTS_PROVIDER=sarvam
SARVAM_API_KEY=
# Optional: Cloudinary photo attachments for damaged intake inspection
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_TRANSPORT=streamable-http
WAREHOUSE_API_BASE_URL=http://127.0.0.1:8080
BOOTSTRAP_ADMIN_EMAIL=admin@whitfield.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-use
INITIALIZE_SCHEMA_ON_STARTUP=true
# Comma-separated allowed Host header values. Set to your real domain in production.
# Example: TRUSTED_HOSTS=api.whitfield.io,whitfield.io
TRUSTED_HOSTS=localhost,127.0.0.1
